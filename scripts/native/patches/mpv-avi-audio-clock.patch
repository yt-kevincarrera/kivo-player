+// AVI audio chunk/index timestamps can jump after damaged compressed packets.
+// Keep valid audio at its declared time: fill forward holes with bounded PCM
+// silence. Normalize backwards metadata resets without dropping valid samples.
+// Explicit seeks flush the pending frame and reset the expected timestamp.
+static struct mp_frame repair_avi_audio_clock(struct priv *p, struct mp_frame frame,
+                                             bool pending)
+{
+    if (frame.type != MP_FRAME_AUDIO || p->play_dir < 0 ||
+        !p->codec->avi_audio_timestamps)
+        return frame;
+
+    struct mp_aframe *audio = frame.data;
+    double pts = mp_aframe_get_pts(audio);
+    double expected = p->pts != MP_NOPTS_VALUE ? p->pts : p->first_packet_pdts;
+    int rate = mp_aframe_get_rate(audio);
+    if (pts == MP_NOPTS_VALUE || expected == MP_NOPTS_VALUE ||
+        !isfinite(pts) || !isfinite(expected) || rate <= 0)
+        return frame;
+
+    if (!pending) {
+        pts = kivo_avi_audio_pts(&p->avi_audio_clock, pts, expected);
+        mp_aframe_set_pts(audio, pts);
+    }
+    int samples = kivo_avi_audio_gap_samples(pts, expected, rate);
+    if (samples > 0) {
+        struct mp_aframe *silence = mp_aframe_create();
+        mp_aframe_config_copy(silence, audio);
+        if (!p->avi_silence_pool)
+            p->avi_silence_pool = mp_aframe_pool_create(p);
+        if (mp_aframe_pool_allocate(p->avi_silence_pool, silence, samples) < 0 ||
+            !mp_aframe_set_silence(silence, 0, samples)) {
+            talloc_free(silence);
+            MP_ERR(p, "Could not allocate AVI audio gap recovery frame.\n");
+            return frame;
+        }
+        mp_aframe_set_pts(silence, expected);
+        p->avi_pending_audio = frame;
+        return MAKE_FRAME(MP_FRAME_AUDIO, silence);
+    }
+    return frame;
+}
